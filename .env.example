# Local development: copy to .env, then `set -a; . ./.env; set +a; cargo run -p rust-afariano`.
# The first start prints a setup link to create the first admin.
RUST_AFARIANO_DATABASE_URL=postgres://rust_afariano:change-me@localhost:5432/rust_afariano
RUST_AFARIANO_PUBLIC_URL=http://localhost:8080
RUST_AFARIANO_DATA_DIR=./data
RUST_AFARIANO_HTTP_ADDR=127.0.0.1:8080
RUST_AFARIANO_SSH_ADDR=127.0.0.1:2222

# Optional single sign-on (OpenID Connect). Redirect URI: <public url>/auth/oidc/callback
# RUST_AFARIANO_OIDC_ISSUER=https://id.example.com/realms/main
# RUST_AFARIANO_OIDC_CLIENT_ID=rust-afariano
# RUST_AFARIANO_OIDC_CLIENT_SECRET=
# RUST_AFARIANO_OIDC_NAME=Keycloak
# RUST_AFARIANO_ALLOWED_EMAILS=*@example.com
